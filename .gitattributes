# Keep authored text consistent across platforms.
* text=auto eol=lf
*.png -text
*.ico -text

# Preserve existing Markdown hard breaks and end-of-file formatting.
*.md whitespace=-blank-at-eol,-blank-at-eof

# Keep upstream runtime distributions and notices byte-identical. Embedded
# template/shader strings may contain intentional trailing whitespace.
website/javascripts/vendor/** -text -whitespace
